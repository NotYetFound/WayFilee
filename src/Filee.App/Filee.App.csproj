<!--
  Filee.App: the Avalonia desktop application (tray, donut toolbar, settings window).
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Filee</AssemblyName>
    <AssemblyTitle>WayFilee</AssemblyTitle>
    <RootNamespace>Filee.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Filee.Core\Filee.Core.csproj" />
    <ProjectReference Include="..\Filee.Engines\Filee.Engines.csproj" />
    <ProjectReference Include="..\Filee.Platform.Linux\Filee.Platform.Linux.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.HarfBuzz" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="SharpHook" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Wayland" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- Shown on the About page. -->
    <AvaloniaResource Include="..\..\THIRD-PARTY-NOTICES.md" Link="Assets\THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Filee.App.Tests" />
  </ItemGroup>

  <!-- Native debug symbols from NuGet packages (SkiaSharp, HarfBuzz: ~100 MB) are useless to users. -->
  <Target Name="FileeRemoveNativeSymbols" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_FileeNativePdb Include="$(PublishDir)lib*.pdb" />
    </ItemGroup>
    <Delete Files="@(_FileeNativePdb)" />
  </Target>

  <!-- Repository URL for the updater / About page, taken from Directory.Build.props. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepositoryUrl</_Parameter1>
      <_Parameter2>$(FileeRepositoryUrl)</_Parameter2>
    </AssemblyAttribute>
    <!-- Published Linux archives and packages set -p:FileeRelease=true; source builds do not. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(FileeRelease)' == 'true'">
      <_Parameter1>FileeRelease</_Parameter1>
      <_Parameter2>true</_Parameter2>
    </AssemblyAttribute>
    <!-- Distro package recipes set -p:WayFileePackageKind=deb|rpm|arch. The updater then
         delegates to the package manager instead of running the per-user tar installer. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(WayFileePackageKind)' == 'deb' Or '$(WayFileePackageKind)' == 'rpm' Or '$(WayFileePackageKind)' == 'arch'">
      <_Parameter1>WayFileePackageKind</_Parameter1>
      <_Parameter2>$(WayFileePackageKind)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
